#!/usr/bin/env bash
# Harness 部署 CLI:harness <mode> [target-dir]
# 把 common/、harness-plan/、harness-<mode>/ 部署到目标项目的 .claude/
# 通过 manifest 跟踪已部署文件,下次部署时自动清理已被废弃的文件(不动用户自定义)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HARNESS_ROOT="$(dirname "$SCRIPT_DIR")"

usage() {
  cat <<'EOF'
用法: harness <mode> [target-dir]

部署 harness 模块到指定项目的 .claude/ 目录。

参数:
  mode         模式名(对应源仓库的 harness-<mode>/ 目录)
  target-dir   目标项目目录,默认当前目录

部署内容:
  common/                       → <target>/.claude/common/
  harness-plan/skills/*         → <target>/.claude/skills/   (通用,自动)
  harness-plan/agents/*         → <target>/.claude/agents/   (通用,自动)
  harness-<mode>/skills/*       → <target>/.claude/skills/
  harness-<mode>/agents/*       → <target>/.claude/agents/

行为:
  - 同名文件直接覆盖
  - 通过 .claude/.harness/installed-manifest 跟踪部署文件;本次源里没有的
    旧文件会被自动清理(只清 manifest 记录过的文件,不动用户自定义文件)

示例:
  harness backend                # 部署到当前目录
  harness backend /path/to/proj  # 部署到指定目录
EOF
}

if [ $# -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  usage
  exit 0
fi

mode="$1"
target_arg="${2:-.}"

mode_dir="$HARNESS_ROOT/harness-$mode"
if [ ! -d "$mode_dir" ]; then
  echo "错误: 未找到模式 'harness-$mode'" >&2
  echo "       期望路径: $mode_dir" >&2
  exit 1
fi

if [ ! -d "$target_arg" ]; then
  echo "错误: 目标目录不存在: $target_arg" >&2
  exit 1
fi

target="$(cd "$target_arg" && pwd)"
echo "部署到: $target/.claude/"

mkdir -p "$target/.claude/skills" "$target/.claude/agents" "$target/.claude/common"
mkdir -p "$target/.claude/.harness"

manifest_file="$target/.claude/.harness/installed-manifest"
new_manifest=$(mktemp)
trap 'rm -f "$new_manifest"' EXIT

# 收集源目录里的所有文件,转为 target 视角相对路径(以 .claude 开头)
# 用法:collect_files <src_dir> <target_prefix>
collect_files() {
  local src="$1" prefix="$2"
  [ -d "$src" ] || return 0
  find "$src" -type f 2>/dev/null | while read -r f; do
    local rel="${f#$src/}"
    echo "${prefix}/${rel}"
  done
}

# 1) 收集本次部署的全部文件清单
{
  collect_files "$HARNESS_ROOT/common" ".claude/common"
  if [ -d "$HARNESS_ROOT/harness-plan" ]; then
    collect_files "$HARNESS_ROOT/harness-plan/skills" ".claude/skills"
    collect_files "$HARNESS_ROOT/harness-plan/agents" ".claude/agents"
  fi
  collect_files "$mode_dir/skills" ".claude/skills"
  collect_files "$mode_dir/agents" ".claude/agents"
} | sort -u > "$new_manifest"

# 2) 与旧 manifest 对比,清理"旧 manifest 有但本次清单没有"的文件
if [ -f "$manifest_file" ]; then
  obsolete=$(comm -23 <(sort -u "$manifest_file") "$new_manifest" || true)
  if [ -n "$obsolete" ]; then
    echo "[清理] 已废弃文件:"
    while IFS= read -r rel; do
      [ -z "$rel" ] && continue
      full="$target/$rel"
      if [ -e "$full" ]; then
        rm -f "$full"
        echo "  - $rel"
      fi
    done <<< "$obsolete"
    # 顺手清空目录(有用户其他文件则 rmdir 失败,自然跳过)
    while IFS= read -r rel; do
      [ -z "$rel" ] && continue
      dir="$(dirname "$target/$rel")"
      while [ "$dir" != "$target" ] && [ "$dir" != "/" ]; do
        rmdir "$dir" 2>/dev/null || break
        dir="$(dirname "$dir")"
      done
    done <<< "$obsolete"
  fi
fi

# 3) 执行部署(cp -r)
deploy_module() {
  local src="$1" name="$2"
  if [ -d "$src/skills" ] && [ -n "$(ls -A "$src/skills" 2>/dev/null)" ]; then
    echo "  [$name] skills → .claude/skills/"
    cp -r "$src/skills/." "$target/.claude/skills/"
  fi
  if [ -d "$src/agents" ] && [ -n "$(ls -A "$src/agents" 2>/dev/null)" ]; then
    echo "  [$name] agents → .claude/agents/"
    cp -r "$src/agents/." "$target/.claude/agents/"
  fi
}

echo "[common] common/ → .claude/common/"
cp -r "$HARNESS_ROOT/common/." "$target/.claude/common/"

if [ -d "$HARNESS_ROOT/harness-plan" ]; then
  deploy_module "$HARNESS_ROOT/harness-plan" "harness-plan"
fi

deploy_module "$mode_dir" "harness-$mode"

# 4) 保存新 manifest(原子覆盖旧的)
mv "$new_manifest" "$manifest_file"
trap - EXIT

count=$(wc -l < "$manifest_file" | tr -d ' ')
echo ""
echo "完成。本次共部署 ${count} 个文件,manifest 已更新。"
echo "在目标项目的 Claude Code 中可使用:"
echo "  /harness-plan       生成 plan 文件"
echo "  /harness-$mode   消费 plan 启动构建与验收"
